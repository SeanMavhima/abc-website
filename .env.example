# ---------------------------------------------------------------
# ABC website — environment variables
# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings -> API).
# ---------------------------------------------------------------

# Public values (safe to expose to the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The public URL of the deployed site (used for SEO, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never commit.
# Used by the seed / create-admin scripts and the "Administrators" page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret used to hash visitor IP addresses for form rate limiting.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_HASH_SALT=change-me-to-a-long-random-string
