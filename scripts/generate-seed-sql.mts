/**
 * Writes supabase/seed.sql from the seed module, for projects where you prefer
 * to paste SQL into the Supabase SQL editor instead of running `npm run seed`.
 * Rows use ON CONFLICT DO NOTHING, so re-running never overwrites your edits.
 */
import fs from "node:fs";
import path from "node:path";
import { seedTables } from "./lib/seed-rows.mts";

const JSON_COLUMNS = new Set([
  "logo", "brand_colors", "og_image", "social_links", "content", "hero_image", "sections",
  "cover_image", "featured_image", "gallery", "photo", "sources",
]);

function literal(column: string, value: unknown): string {
  if (value === null || value === undefined) return "null";
  if (JSON_COLUMNS.has(column)) return `'${JSON.stringify(value).replace(/'/g, "''")}'::jsonb`;
  if (typeof value === "boolean") return value ? "true" : "false";
  if (typeof value === "number") return String(value);
  return `'${String(value).replace(/'/g, "''")}'`;
}

const out: string[] = [
  "-- ABC seed content (generated by scripts/generate-seed-sql.mts). Safe to re-run.",
  "begin;",
];
for (const { table, rows } of seedTables()) {
  if (!rows.length) continue;
  const columns = Object.keys(rows[0]);
  out.push(`\n-- ${table}`);
  out.push(`insert into public.${table} (${columns.join(", ")}) values`);
  out.push(rows.map((r) => `  (${columns.map((c) => literal(c, r[c])).join(", ")})`).join(",\n"));
  out.push("on conflict (id) do nothing;");
}
out.push("\ncommit;\n");

const file = path.resolve("supabase/seed.sql");
fs.writeFileSync(file, out.join("\n"));
console.log(`Wrote ${path.relative(process.cwd(), file)}`);
